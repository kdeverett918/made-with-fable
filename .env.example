# Browser-safe
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Resend). Without RESEND_API_KEY emails are skipped (logged).
# EMAIL_FROM must be a Resend-verified domain to email authors; the default
# onboarding sender can only reach the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=kdeverett918@gmail.com

# Optional for `npm run seed:dizzy` when there is no existing `dizzy` profile.
DIZZY_USER_ID=
DIZZY_CURRENT_USERNAME=
KEEP_DEMO_CONTENT=
